# Shadow IT & Data Leak Finder - Environment Configuration
# Copy this file to .env and fill in your values

# OpenCode/Big Pickle API Configuration
OPENCODE_API_ENDPOINT=https://api.opencode.ai/v1/chat/completions
OPENCODE_API_KEY=your_api_key_here
BIG_PICKLE_MODEL=big-pickle
MODEL_NAME=big-pickle

# Request Configuration
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
RATE_LIMIT_WAIT=60

# Application Configuration
LOG_LEVEL=INFO
SCAN_INTERVAL_MINUTES=60
OUTPUT_DIR=./outputs
MAX_RAW_DATA_SIZE_MB=10

# Environment
ENVIRONMENT=production
