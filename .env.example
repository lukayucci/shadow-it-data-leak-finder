# Shadow IT & Data Leak Finder - Environment Configuration
# Copy this file to .env and fill in your values.

# --- App security (obligatorio en producción) ---
# Generá una clave con: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=change_me_with_a_random_48_char_secret
ENVIRONMENT=development
# Forzá cookies Secure solo sobre HTTPS (dejar en true en producción).
SECURE_COOKIES=false

# --- OpenCode/Big Pickle API Configuration (opcional para el CLI) ---
OPENCODE_API_ENDPOINT=https://api.opencode.ai/v1/chat/completions
OPENCODE_API_KEY=your_api_key_here
BIG_PICKLE_MODEL=big-pickle
MODEL_NAME=big-pickle
TARGET_ORGANIZATION=tu-organizacion.com

# --- Database ---
# En producción usar Postgres, por ejemplo:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/zero
DATABASE_URL=sqlite:///./shadowit_saas.db

# Request Configuration
REQUEST_TIMEOUT=120
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
RATE_LIMIT_WAIT=60

# Application Configuration
LOG_LEVEL=INFO
SCAN_INTERVAL_MINUTES=60
OUTPUT_DIR=./outputs
MAX_RAW_DATA_SIZE_MB=10
